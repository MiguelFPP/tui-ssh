COMPOSE ?= docker compose
COMPOSE_RUN = $(COMPOSE) run --rm --no-deps -T

.DEFAULT_GOAL := help

.PHONY: help dev dev-ssh run run-ssh build test test-pkg test-run test-integration test-race vet vet-pkg bench-pkg fmt tidy clean

help: ## List available targets
	@awk 'BEGIN {FS = ":.*##"} /^[a-zA-Z_-]+:.*##/ {printf "  \033[36m%-17s\033[0m %s\n", $$1, $$2}' $(MAKEFILE_LIST)

dev: ## Run the TUI with hot reload (needs a TTY)
	$(COMPOSE) run --rm dev

dev-ssh: ## Run the TUI with hot reload, ~/.ssh read-only and the host network (needs a TTY)
	$(COMPOSE) --profile ssh run --rm dev-ssh

run: ## Run the TUI from the production image (needs a TTY)
	$(COMPOSE) --profile prod run --rm app

run-ssh: ## Run the TUI from the production image with ~/.ssh and the host network (needs a TTY)
	$(COMPOSE) --profile prod-ssh run --rm app-ssh

build: ## Build the Docker images
	$(COMPOSE) --profile prod build

test: ## Run go test ./... inside the dev container (CI and final phase only)
	$(COMPOSE_RUN) dev go test -count=1 ./...

vet: ## Run go vet ./... inside the dev container (CI and final phase only)
	$(COMPOSE_RUN) dev go vet ./...

test-pkg: ## Run the tests of one package: make test-pkg PKG='./internal/<pkg>/...'
	@test -n "$(PKG)" || { echo "test-pkg: PKG is required, e.g. make test-pkg PKG='./internal/config/...'"; exit 1; }
	$(COMPOSE_RUN) dev go test $(PKG)

test-run: ## Run matching tests of one package: make test-run PKG='...' RUN='TestName'
	@test -n "$(PKG)" || { echo "test-run: PKG is required, e.g. make test-run PKG='./internal/config/...' RUN='TestParse'"; exit 1; }
	@test -n "$(RUN)" || { echo "test-run: RUN is required, e.g. make test-run PKG='./internal/config/...' RUN='TestParse'"; exit 1; }
	$(COMPOSE_RUN) dev go test -run '$(RUN)' $(PKG)

test-integration: ## Run integration tests: make test-integration PKG='...' [RUN='TestIntegration...']
	@test -n "$(PKG)" || { echo "test-integration: PKG is required, e.g. make test-integration PKG='./internal/adapters/tunnel/...'"; exit 1; }
	$(COMPOSE_RUN) dev go test -tags integration $(if $(RUN),-run '$(RUN)') $(PKG)

test-race: ## Run go test -race ./... inside the dev container (final phase only)
	$(COMPOSE_RUN) -e CGO_ENABLED=1 dev go test -race -count=1 ./...

vet-pkg: ## Run go vet for one package: make vet-pkg PKG='./internal/<pkg>/...'
	@test -n "$(PKG)" || { echo "vet-pkg: PKG is required, e.g. make vet-pkg PKG='./internal/config/...'"; exit 1; }
	$(COMPOSE_RUN) dev go vet $(PKG)

bench-pkg: ## Run the benchmarks of one package: make bench-pkg PKG='./internal/<pkg>/...'
	@test -n "$(PKG)" || { echo "bench-pkg: PKG is required, e.g. make bench-pkg PKG='./internal/tui/components/tunnelpanel/...'"; exit 1; }
	$(COMPOSE_RUN) dev go test -run '^$$' -bench . -benchmem $(PKG)

fmt: ## Run go fmt inside the dev container
	$(COMPOSE_RUN) dev go fmt ./...

tidy: ## Run go mod tidy inside the dev container
	$(COMPOSE_RUN) dev go mod tidy

clean: ## Remove build artifacts generated by Air
	$(COMPOSE_RUN) dev rm -rf tmp bin
